<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Your Account - Vuma Traffic</title>
  <meta name="description" content="Sign up free for Vuma Traffic. No credit card required. Start generating website traffic in minutes.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://traffic.nyxseo.com/register">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',-apple-system,sans-serif;background:#0a0e1a;color:#e2e8f0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;background:radial-gradient(ellipse at 50% 0%,rgba(59,130,246,0.05),transparent 60%)}
    .card{background:linear-gradient(135deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01));border:1px solid rgba(255,255,255,0.06);border-radius:1.5rem;padding:2.5rem;width:100%;max-width:420px;backdrop-filter:blur(20px)}
    .logo{font-size:1.5rem;font-weight:800;background:linear-gradient(135deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-decoration:none;display:inline-block;margin-bottom:0.25rem}
    h1{font-size:1.5rem;font-weight:700;margin-bottom:0.25rem}
    .sub{color:#64748b;font-size:0.875rem;margin-bottom:2rem}
    label{display:block;font-size:0.8125rem;font-weight:500;color:#94a3b8;margin-bottom:0.375rem}
    input{width:100%;padding:0.75rem 1rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:0.75rem;color:#e2e8f0;font-size:0.875rem;outline:none;transition:border-color 0.2s}
    input:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,0.1)}
    input::placeholder{color:#475569}
    .btn{width:100%;padding:0.75rem;border-radius:0.75rem;font-size:0.875rem;font-weight:600;border:none;cursor:pointer;background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;transition:all 0.3s}
    .btn:hover{transform:translateY(-1px);box-shadow:0 8px 30px rgba(59,130,246,0.3)}
    .btn:disabled{opacity:0.5;cursor:not-allowed;transform:none}
    .error{background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:0.75rem;padding:0.75rem;font-size:0.8125rem;color:#fca5a5;margin-bottom:1rem;display:none}
    .footer{text-align:center;margin-top:1.5rem;font-size:0.8125rem;color:#475569}
    .footer a{color:#60a5fa;text-decoration:none}
    .footer a:hover{text-decoration:underline}
    .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  </style>
</head>
<body>
  <div class="card">
    <div style="text-align:center;margin-bottom:1.5rem">
      <a href="/" class="logo">Vuma</a>
      <h1>Create your account</h1>
      <p class="sub">Start free. No credit card needed.</p>
    </div>

    <div id="error" class="error" role="alert"></div>

    <form onsubmit="handleRegister(event)" autocomplete="off">
      <div style="margin-bottom:1rem">
        <label for="name">Full name</label>
        <input id="name" type="text" placeholder="Your name" required autocomplete="name">
      </div>
      <div style="margin-bottom:1rem">
        <label for="email">Email address</label>
        <input id="email" type="email" placeholder="you@example.com" required autocomplete="email">
      </div>
      <div style="margin-bottom:1.5rem">
        <label for="password">Password</label>
        <input id="password" type="password" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password">
      </div>
      <button type="submit" id="submitBtn" class="btn">Create free account</button>
    </form>

    <div class="footer">
      Already have an account? <a href="/login">Sign in</a>
    </div>
  </div>

  <script>
    function getPlanFromUrl() {
      const p = new URLSearchParams(location.search).get('plan');
      return p && p !== 'free' ? p : null;
    }

    async function handleRegister(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      const err = document.getElementById('error');
      const form = e.target;

      btn.disabled = true;
      btn.textContent = 'Creating account...';
      err.style.display = 'none';

      const name = form.name.value.trim();
      const email = form.email.value.trim();
      const password = form.password.value;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password })
        });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Registration failed');
        }

        localStorage.setItem('vuma_token', data.token);
        localStorage.setItem('vuma_refresh', data.refreshToken);
        localStorage.setItem('vuma_user', JSON.stringify(data.user));
        document.cookie = 'vumaToken=' + data.token + '; path=/; max-age=' + (60*60*24*7);

        const plan = getPlanFromUrl();
        if (plan) {
          document.cookie = 'upgradePlan=' + plan + '; path=/; max-age=3600';
        }

        window.location.href = '/dashboard';
      } catch (e) {
        err.textContent = e.message;
        err.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Create free account';
      }
    }
  </script>
</body>
</html>
