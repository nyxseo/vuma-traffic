<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vuma Traffic - Website Traffic Generator &amp; SEO Automation</title>
  <meta name="description" content="Generate real organic website traffic with Vuma. Multi-platform automation, anti-detection technology, proxy support, and live analytics. Start free.">
  <link rel="canonical" href="https://traffic.nyxseo.com/">

  <!-- Open Graph -->
  <meta property="og:title" content="Vuma Traffic - Automated Website Traffic Generation">
  <meta property="og:description" content="Drive real organic traffic to your website with AI-powered browser automation. Trusted by 500+ users.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://traffic.nyxseo.com/">

  <!-- JSON-LD -->
  <script type="application/ld+json">{
    "@context":"https://schema.org","@type":"SoftwareApplication","name":"Vuma Traffic",
    "applicationCategory":"TrafficGenerator","operatingSystem":"Windows",
    "description":"Advanced website traffic generation tool with multi-platform support and anti-detection.",
    "offers":{"@type":"AggregateOffer","lowPrice":"0","highPrice":"1499","priceCurrency":"USD"}
  }</script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    /* ── Reset & Base ── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#020617;color:#f1f5f9;overflow-x:hidden;-webkit-font-smoothing:antialiased}

    /* ── Glassmorphism Card ── */
    .glass{background:rgba(255,255,255,0.03);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.06);border-radius:1.25rem}
    .glass-strong{background:rgba(255,255,255,0.05);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.08);border-radius:1.25rem}
    .glass-hover{transition:all 0.3s cubic-bezier(0.16,1,0.3,1)}
    .glass-hover:hover{transform:translateY(-4px);border-color:rgba(59,130,246,0.2);box-shadow:0 12px 48px rgba(59,130,246,0.12)}

    /* ── Typography ── */
    h1,h2,h3{font-weight:700;letter-spacing:-0.02em}
    .gradient-text{background:linear-gradient(135deg,#60a5fa,#a78bfa,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .gradient-green{background:linear-gradient(135deg,#22c55e,#16a34a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

    /* ── Nav ── */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0.875rem 2rem;background:rgba(2,6,23,0.8);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:space-between}
    .logo{font-size:1.375rem;font-weight:800;background:linear-gradient(135deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-decoration:none}
    .nav-link{color:#94a3b8;text-decoration:none;font-size:0.875rem;font-weight:500;transition:color 0.2s;padding:0.5rem 0.75rem;border-radius:0.5rem}
    .nav-link:hover{color:#f1f5f9;background:rgba(255,255,255,0.04)}
    .hamburger{display:none;background:none;border:none;color:#f1f5f9;font-size:1.5rem;cursor:pointer;padding:0.25rem}

    /* ── Buttons ── */
    .btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;border-radius:0.75rem;font-size:0.875rem;font-weight:600;text-decoration:none;transition:all 0.25s cubic-bezier(0.16,1,0.3,1);cursor:pointer;border:none;white-space:nowrap}
    .btn-primary{background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;box-shadow:0 4px 24px rgba(59,130,246,0.25)}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 40px rgba(59,130,246,0.35)}
    .btn-secondary{background:rgba(255,255,255,0.05);color:#f1f5f9;border:1px solid rgba(255,255,255,0.08)}
    .btn-secondary:hover{background:rgba(255,255,255,0.08);border-color:rgba(255,255,255,0.12)}
    .btn-green{background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;box-shadow:0 4px 24px rgba(34,197,94,0.25)}
    .btn-green:hover{transform:translateY(-2px);box-shadow:0 8px 40px rgba(34,197,94,0.35)}

    /* ── Hero ── */
    .hero{min-height:100vh;display:flex;align-items:center;position:relative;overflow:hidden;background:#020617;padding:6rem 2rem 4rem}
    .hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(59,130,246,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,0.04) 1px,transparent 1px);background-size:80px 80px;pointer-events:none}
    .hero-glow{position:absolute;width:600px;height:600px;border-radius:50%;filter:blur(120px);pointer-events:none}
    .hero-glow-1{top:-200px;left:-200px;background:radial-gradient(circle,rgba(59,130,246,0.12),transparent)}
    .hero-glow-2{bottom:-200px;right:-200px;background:radial-gradient(circle,rgba(139,92,246,0.1),transparent)}
    .hero-content{position:relative;z-index:10;text-align:center;max-width:800px;margin:0 auto}
    .hero-badge{display:inline-flex;align-items:center;gap:0.5rem;padding:0.375rem 1rem;border-radius:999px;background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.15);font-size:0.8125rem;color:#93bbfc;margin-bottom:1.5rem}
    .hero h1{font-size:clamp(2.5rem,5.5vw,4.25rem);line-height:1.05;margin-bottom:1.25rem;font-weight:800}
    .hero p{font-size:clamp(1rem,1.25vw,1.2rem);color:#64748b;max-width:580px;margin:0 auto 2rem;line-height:1.7}
    .hero-cta{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-bottom:3rem}
    .hero-stats{display:flex;justify-content:center;gap:3rem;flex-wrap:wrap;padding-top:2rem;border-top:1px solid rgba(255,255,255,0.05);max-width:480px;margin:0 auto}

    /* ── Sections ── */
    section{padding:5rem 2rem}
    .section-inner{max-width:1100px;margin:0 auto}
    .section-label{font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#60a5fa;margin-bottom:0.75rem}
    .section-title{font-size:clamp(1.75rem,3vw,2.5rem);font-weight:700;margin-bottom:0.75rem}
    .section-sub{color:#64748b;font-size:1rem;max-width:500px;line-height:1.6}

    /* ── Feature Grid ── */
    .features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.25rem}
    .features-grid .glass{padding:2rem}
    .features-grid .icon{width:3rem;height:3rem;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;margin-bottom:1rem;background:linear-gradient(135deg,rgba(59,130,246,0.1),rgba(139,92,246,0.1))}
    .features-grid h3{font-size:1.05rem;font-weight:600;margin-bottom:0.5rem}
    .features-grid p{font-size:0.875rem;color:#64748b;line-height:1.7}

    /* ── Pricing ── */
    .pricing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;max-width:1060px;margin:2rem auto 0}
    .pricing-card{position:relative}
    .pricing-card.popular{border-color:rgba(59,130,246,0.3);box-shadow:0 0 48px rgba(59,130,246,0.1)}
    .pricing-popular-badge{position:absolute;top:-0.75rem;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#3b82f6,#6366f1);padding:0.25rem 1rem;border-radius:999px;font-size:0.75rem;font-weight:600;white-space:nowrap}
    .pricing-card .price{font-size:2.75rem;font-weight:800;margin-bottom:0.25rem}
    .pricing-card .price span{font-size:0.875rem;font-weight:400;color:#64748b}
    .pricing-card .period{font-size:0.75rem;color:#475569;margin-bottom:1.5rem}
    .pricing-card ul{list-style:none;font-size:0.8125rem;color:#94a3b8;margin-bottom:2rem}
    .pricing-card ul li{padding:0.375rem 0;display:flex;align-items:center;gap:0.5rem}
    .pricing-card ul li::before{content:'';width:1.25rem;height:1.25rem;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:0.625rem;flex-shrink:0}
    .pricing-card ul li.inc::before{content:'+';background:rgba(34,197,94,0.12);color:#22c55e}
    .pricing-card ul li.exc::before{content:'';background:rgba(100,116,139,0.08);color:#475569}

    /* ── How it works ── */
    .steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2rem;max-width:850px;margin:2rem auto 0}
    .step-number{width:3.5rem;height:3.5rem;border-radius:50%;background:linear-gradient(135deg,rgba(59,130,246,0.12),rgba(139,92,246,0.12));display:flex;align-items:center;justify-content:center;font-size:1.125rem;font-weight:700;color:#60a5fa;margin:0 auto 1rem}

    /* ── Stats visualization ── */
    .viz-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;padding:1.5rem;background:rgba(255,255,255,0.02);border-radius:1rem;margin-bottom:1rem}
    .viz-bar{height:0.5rem;border-radius:999px;background:rgba(59,130,246,0.08);overflow:hidden;margin-top:0.5rem}
    .viz-bar-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,#3b82f6,#6366f1);transition:width 1s cubic-bezier(0.16,1,0.3,1)}

    /* ── Trust badges ── */
    .trust-row{display:flex;justify-content:center;gap:2.5rem;flex-wrap:wrap;padding:2rem 0;opacity:0.4;filter:grayscale(1)}
    .trust-row span{font-size:1.25rem;font-weight:700;color:#94a3b8;letter-spacing:-0.01em}

    /* ── FAQ ── */
    .faq-item{border-bottom:1px solid rgba(255,255,255,0.05)}
    .faq-q{width:100%;background:none;border:none;color:#f1f5f9;padding:1.25rem 0;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-size:1rem;font-weight:500;text-align:left;gap:1rem}
    .faq-q:hover{color:#60a5fa}
    .faq-a{max-height:0;overflow:hidden;transition:max-height 0.3s cubic-bezier(0.16,1,0.3,1);color:#64748b;font-size:0.875rem;line-height:1.7}

    /* ── CTA section ── */
    .cta-section{text-align:center;background:linear-gradient(135deg,rgba(59,130,246,0.04),rgba(139,92,246,0.04));border-radius:2rem;padding:4rem 2rem}
    .cta-section h2{font-size:clamp(1.5rem,2.5vw,2rem);margin-bottom:0.75rem}

    /* ── Footer ── */
    footer{padding:2rem;text-align:center;border-top:1px solid rgba(255,255,255,0.04);color:#334155;font-size:0.8125rem}

    /* ── Mobile ── */
    @media(max-width:900px){
      .pricing-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:480px){
      .pricing-grid{grid-template-columns:1fr}
    }
    @media(max-width:768px){
      nav{padding:0.75rem 1rem}
      .nav-links{display:none;position:fixed;top:3.75rem;left:0;right:0;background:rgba(2,6,23,0.98);padding:1.5rem;flex-direction:column;gap:0.5rem;border-bottom:1px solid rgba(255,255,255,0.05)}
      .nav-links.open{display:flex}
      .hamburger{display:block}
      .hero{padding:5rem 1rem 3rem}
      .hero-stats{gap:1.5rem}
      .viz-grid{grid-template-columns:repeat(2,1fr)}
      .pricing-grid{grid-template-columns:1fr;max-width:400px}
    }
    @media(max-width:480px){
      .features-grid{grid-template-columns:1fr}
      .steps-grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>

<!-- ─── Navbar ─── -->
<nav>
  <a href="/" class="logo">Vuma</a>
  <div class="nav-links" id="navLinks">
    <a href="#features" class="nav-link">Features</a>
    <a href="#pricing" class="nav-link">Pricing</a>
    <a href="#faq" class="nav-link">FAQ</a>
    <a href="/login" class="nav-link" style="color:#60a5fa">Sign in</a>
    <a href="/register" class="btn btn-primary" style="padding:0.5rem 1.25rem;font-size:0.8125rem">Get started free</a>
  </div>
  <button class="hamburger" onclick="document.getElementById('navLinks').classList.toggle('open')">☰</button>
</nav>

<!-- ─── Hero ─── -->
<section class="hero">
  <div class="hero-grid"></div>
  <div class="hero-glow hero-glow-1"></div>
  <div class="hero-glow hero-glow-2"></div>
  <div class="hero-content">
    <div class="hero-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Trusted by 500+ website owners
    </div>
    <h1>Turn your website traffic numbers around with automated precision</h1>
    <p>Vuma sends real, organic-looking visitors to your site using browser automation. Multi-platform, anti-detection, and fully under your control.</p>
    <div class="hero-cta">
      <a href="/register" class="btn btn-primary">Start free trial</a>
      <a href="#pricing" class="btn btn-secondary">View pricing</a>
    </div>

    <!-- Live stats visualization -->
    <div class="glass" style="padding:1.5rem;text-align:left;max-width:520px;margin:0 auto">
      <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:#64748b;margin-bottom:0.75rem">
        <span>Live traffic</span>
        <span style="color:#22c55e">&#9679; 1,284 active today</span>
      </div>
      <div class="viz-grid" style="grid-template-columns:repeat(4,1fr);padding:0;margin:0;background:none">
        <div><div style="font-size:0.8125rem;font-weight:600">Google</div><div style="font-size:1.25rem;font-weight:700">584</div><div class="viz-bar"><div class="viz-bar-fill" style="width:85%"></div></div></div>
        <div><div style="font-size:0.8125rem;font-weight:600">Social</div><div style="font-size:1.25rem;font-weight:700">342</div><div class="viz-bar"><div class="viz-bar-fill" style="width:62%"></div></div></div>
        <div><div style="font-size:0.8125rem;font-weight:600">Direct</div><div style="font-size:1.25rem;font-weight:700">218</div><div class="viz-bar"><div class="viz-bar-fill" style="width:47%"></div></div></div>
        <div><div style="font-size:0.8125rem;font-weight:600">Search</div><div style="font-size:1.25rem;font-weight:700">140</div><div class="viz-bar"><div class="viz-bar-fill" style="width:32%"></div></div></div>
      </div>
    </div>

    <div class="hero-stats">
      <div style="text-align:center"><div class="gradient-text" style="font-size:1.75rem;font-weight:800">500+</div><div style="font-size:0.75rem;color:#475569;margin-top:0.125rem">Active users</div></div>
      <div style="text-align:center"><div class="gradient-text" style="font-size:1.75rem;font-weight:800">10M+</div><div style="font-size:0.75rem;color:#475569;margin-top:0.125rem">Daily visits</div></div>
      <div style="text-align:center"><div class="gradient-text" style="font-size:1.75rem;font-weight:800">8</div><div style="font-size:0.75rem;color:#475569;margin-top:0.125rem">Platforms</div></div>
    </div>
  </div>
</section>

<!-- ─── Features ─── -->
<section id="features" style="padding:3rem 2rem 5rem">
  <div class="section-inner">
    <div style="text-align:center;margin-bottom:3rem">
      <div class="section-label">Features</div>
      <h2 class="section-title">Everything you need to grow</h2>
      <p class="section-sub" style="margin:0 auto">One platform, multiple traffic sources. Vuma mimics real visitor behavior across several channels.</p>
    </div>
    <div class="features-grid">
      <div class="glass glass-hover">
        <div class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
        <h3>Multi-platform traffic</h3>
        <p>Generate visitors from search engines, social media, video platforms, and direct sources. Each visit appears to come from a real referrer.</p>
      </div>
      <div class="glass glass-hover">
        <div class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3>Anti-detection system</h3>
        <p>Browser fingerprint randomization and stealth techniques make every visit look organic. Your traffic stays under the radar.</p>
      </div>
      <div class="glass glass-hover">
        <div class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3>Realistic user behavior</h3>
        <p>Scrolling, clicking, mouse movement, and reading patterns that mirror real people. No detectable bot patterns.</p>
      </div>
      <div class="glass glass-hover">
        <div class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.5"><path d="M4 20h16"/><path d="M4 20V4"/><path d="M20 20V8"/><path d="M8 20v-4"/><path d="M12 20v-8"/><path d="M16 20v-6"/></svg>
        </div>
        <h3>Live analytics</h3>
        <p>Track daily hits, total visits, data usage, and remaining quota in real time from your dashboard.</p>
      </div>
      <div class="glass glass-hover">
        <div class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.5"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <h3>Proxy integration</h3>
        <p>Route traffic through SOCKS5 and HTTP proxies. Distribute visits across multiple IP addresses.</p>
      </div>
      <div class="glass glass-hover">
        <div class="icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.5"><path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/></svg>
        </div>
        <h3>Multi-threading</h3>
        <p>Run multiple workers simultaneously. Each thread independently drives visits. Scale up by adding more threads.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── How It Works ─── -->
<section style="padding:3rem 2rem 5rem;background:rgba(255,255,255,0.01)">
  <div class="section-inner">
    <div style="text-align:center;margin-bottom:2rem">
      <div class="section-label">How it works</div>
      <h2 class="section-title">Get started in three steps</h2>
    </div>
    <div class="steps-grid">
      <div style="text-align:center">
        <div class="step-number">1</div>
        <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.5rem">Create your account</h3>
        <p style="font-size:0.875rem;color:#64748b">Sign up free. No credit card. Choose a plan that fits your traffic needs.</p>
      </div>
      <div style="text-align:center">
        <div class="step-number">2</div>
        <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.5rem">Download and log in</h3>
        <p style="font-size:0.875rem;color:#64748b">Install Vuma Desktop on your PC and log in with your account.</p>
      </div>
      <div style="text-align:center">
        <div class="step-number">3</div>
        <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.5rem">Start generating traffic</h3>
        <p style="font-size:0.875rem;color:#64748b">Configure your settings and click Start. Vuma handles the rest.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── Pricing ─── -->
<section id="pricing" class="section-inner" style="padding:3rem 2rem 5rem">
  <div style="text-align:center;margin-bottom:1rem">
    <div class="section-label">Pricing</div>
    <h2 class="section-title">Simple, transparent pricing</h2>
    <p class="section-sub" style="margin:0 auto">Start free, upgrade when you need more traffic.</p>
  </div>

  <div class="pricing-grid">
    <% if (typeof plans !== 'undefined' && plans && plans.length) { plans.forEach(function(p) { %>
    <div class="pricing-card glass glass-hover<%= p.id === 'pro' ? ' popular' : '' %>" style="padding:2rem">
      <% if (p.id === 'pro') { %><div class="pricing-popular-badge">Most popular</div><% } %>
      <div style="font-size:1.125rem;font-weight:700;margin-bottom:0.25rem"><%= p.name %></div>
      <div style="font-size:0.8125rem;color:#64748b;margin-bottom:1rem"><%= p.description %></div>
      <div class="price">$<%= Math.round(p.priceMonthly / 16000) %><span>/month</span></div>
      <div class="period">$<%= Math.round(p.priceYearly / 16000 / 12) %>/month billed yearly</div>
      <ul>
        <li class="inc"><%= p.trafficLimitDaily >= 999999999 ? 'Unlimited' : p.trafficLimitDaily.toLocaleString() %> visits per day</li>
        <li class="inc"><%= p.fingerprintLimit >= 999999 ? 'Unlimited' : p.fingerprintLimit %> browser fingerprints</li>
        <li class="inc"><%= p.threadLimit %> concurrent threads</li>
        <li class="<%= p.isProxyEnabled ? 'inc' : 'exc' %>">Proxy support</li>
        <li class="<%= p.isAdNetworksEnabled ? 'inc' : 'exc' %>">Ad network integration</li>
        <li class="<%= p.isSearchEngine ? 'inc' : 'exc' %>">Search engine traffic</li>
      </ul>
      <a href="/register?plan=<%= p.id %>" class="btn btn-primary" style="width:100%;justify-content:center">
        Get started &rarr;
      </a>
    </div>
    <% }); } %>
  </div>
</section>

