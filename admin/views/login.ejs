<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Vuma Traffic</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',-apple-system,sans-serif;background:#0F172A;color:#F8FAFC;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem}
    body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 50% 30%,rgba(34,197,94,0.04),transparent 70%);pointer-events:none}
    .card{width:400px;background:rgba(255,255,255,0.02);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.04);border-radius:1.5rem;padding:2.5rem;position:relative;overflow:hidden}
    .card::before{content:'';position:absolute;top:-80px;right:-80px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(34,197,94,0.06),transparent 70%)}
    .logo{font-size:2rem;font-weight:800;background:linear-gradient(135deg,#22c55e,#16a34a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-align:center;margin-bottom:0.25rem}
    h1{font-size:1.375rem;font-weight:700;text-align:center;margin-bottom:0.25rem}
    .sub{color:#64748b;font-size:0.8125rem;text-align:center;margin-bottom:2rem}
    label{display:block;font-size:0.75rem;color:#94a3b8;font-weight:500;margin-bottom:0.25rem}
    input{width:100%;padding:0.625rem 0.875rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:0.625rem;color:#F8FAFC;font-size:0.8125rem;outline:none;transition:border-color 0.2s}
    input:focus{border-color:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,0.06)}
    input::placeholder{color:#475569}
    .btn{width:100%;padding:0.75rem;border-radius:0.625rem;font-size:0.8125rem;font-weight:600;border:none;cursor:pointer;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;transition:all 0.2s}
    .btn:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(34,197,94,0.2)}
    .error{background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.15);border-radius:0.625rem;padding:0.75rem;font-size:0.8125rem;color:#fca5a5;margin-bottom:1rem}
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">Vuma</div>
    <h1>Admin Panel</h1>
    <p class="sub">Sign in to manage your platform.</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/login" autocomplete="off">
      <div style="margin-bottom:1rem">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="admin@vuma.id" required>
      </div>
      <div style="margin-bottom:1.5rem">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter password" required>
      </div>
      <button type="submit" class="btn">Sign In</button>
    </form>

    <div style="text-align:center;margin-top:1.5rem;font-size:0.75rem;color:#334155">
      Vuma Traffic Admin v1.0
    </div>
  </div>
</body>
</html>
