{
  "name": "vuma-traffic",
  "version": "1.0.0",
  "description": "Vuma Traffic - Enterprise Traffic Automation Engine",
  "main": "main/main.js",
  "author": {
    "name": "Vuma Technologies",
    "email": "support@vuma.id"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --x64 --publish never",
    "build:dir": "electron-builder build --win --x64 --dir",
    "publish": "electron-builder build --win --x64 --publish always"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vuma.traffic",
    "productName": "Vuma Traffic",
    "copyright": "Copyright (c) 2025 Vuma Technologies",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vuma Traffic",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "license": null,
      "runAfterFinish": true,
      "menuCategory": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraMetadata": {
      "main": "main/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "vuma",
      "repo": "vuma-traffic",
      "releaseType": "release"
    }
  }
}
